---
interface Slide {
  src: string;
  alt: string;
}

interface Props {
  slides: Slide[];
  interval?: number;
  aspectRatio?: string;
}

const { slides, interval = 5000, aspectRatio } = Astro.props;
const fallbackSlides: Slide[] = [
  {
    src: "/profile-website/PurchaseOrder.png",
    alt: "Project preview placeholder",
  },
];
const carouselSlides = slides.length > 0 ? slides : fallbackSlides;
---

<div
  class:list={["project-carousel", { "project-carousel--fixed": aspectRatio }]}
  style={aspectRatio ? `--carousel-aspect-ratio: ${aspectRatio}` : undefined}
  data-carousel
  data-interval={interval}
  tabindex="0"
  aria-roledescription="carousel"
  aria-label="Project screenshots"
>
  <div class="project-carousel__viewport">
    <div class="project-carousel__track" data-carousel-track>
      {carouselSlides.map((slide, index) => (
        <button
          type="button"
          class:list={[
            "project-carousel__slide",
            { "project-carousel__slide--active": index === 0 },
          ]}
          data-carousel-slide
          data-index={index}
          aria-label={`Open screenshot ${index + 1}`}
        >
          <img src={slide.src} alt={slide.alt} loading={index === 0 ? "eager" : "lazy"} />
        </button>
      ))}
    </div>

    {carouselSlides.length > 1 && (
      <>
        <button type="button" class="project-carousel__arrow project-carousel__arrow--previous" data-carousel-previous aria-label="Previous screenshot">
          <span aria-hidden="true">&#8592;</span>
        </button>
        <button type="button" class="project-carousel__arrow project-carousel__arrow--next" data-carousel-next aria-label="Next screenshot">
          <span aria-hidden="true">&#8594;</span>
        </button>
      </>
    )}
  </div>

  {carouselSlides.length > 1 && (
    <div class="project-carousel__dots" role="tablist" aria-label="Choose screenshot">
      {carouselSlides.map((_, index) => (
        <button
          type="button"
          class:list={["project-carousel__dot", { "project-carousel__dot--active": index === 0 }]}
          data-carousel-dot
          data-index={index}
          role="tab"
          aria-label={`Show screenshot ${index + 1}`}
          aria-selected={index === 0}
        ></button>
      ))}
    </div>
  )}
</div>

<script define:vars={{ interval }}>
  const initializeCarousels = () => {
    const carousels = document.querySelectorAll("[data-carousel]");

    carousels.forEach((carousel) => {
    if (carousel.dataset.initialized === "true") return;
    carousel.dataset.initialized = "true";

    const slides = Array.from(carousel.querySelectorAll("[data-carousel-slide]"));
    const dots = Array.from(carousel.querySelectorAll("[data-carousel-dot]"));
    const previous = carousel.querySelector("[data-carousel-previous]");
    const next = carousel.querySelector("[data-carousel-next]");
    let activeIndex = 0;
    let timer;
    let pointerStartX;
    let pointerCurrentX;
    let gestureType;

    const showSlide = (index) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        slide.classList.toggle("project-carousel__slide--active", slideIndex === activeIndex);
        slide.setAttribute("aria-hidden", String(slideIndex !== activeIndex));
      });
      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === activeIndex;
        dot.classList.toggle("project-carousel__dot--active", isActive);
        dot.setAttribute("aria-selected", String(isActive));
      });
    };

    const stopAutoplay = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const startAutoplay = () => {
      stopAutoplay();
      if (slides.length > 1) timer = window.setInterval(() => showSlide(activeIndex + 1), interval);
    };

    previous?.addEventListener("click", () => {
      showSlide(activeIndex - 1);
      startAutoplay();
    });
    next?.addEventListener("click", () => {
      showSlide(activeIndex + 1);
      startAutoplay();
    });
    dots.forEach((dot) => dot.addEventListener("click", () => {
      showSlide(Number(dot.dataset.index));
      startAutoplay();
    }));

      const beginGesture = (clientX, type) => {
        gestureType = type;
        pointerStartX = clientX;
        pointerCurrentX = clientX;
        stopAutoplay();
      };

      const finishGesture = (clientX, type) => {
        if (gestureType !== type || pointerStartX === undefined) return;
        const distance = (clientX ?? pointerCurrentX) - pointerStartX;
        if (Math.abs(distance) > 40) showSlide(activeIndex + (distance < 0 ? 1 : -1));
        pointerStartX = undefined;
        pointerCurrentX = undefined;
        gestureType = undefined;
        startAutoplay();
      };

      carousel.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "touch") return;
        beginGesture(event.clientX, "pointer");
      });
      carousel.addEventListener("pointermove", (event) => {
        if (gestureType === "pointer") pointerCurrentX = event.clientX;
      });
      carousel.addEventListener("pointerup", (event) => {
        if (event.pointerType === "touch") return;
        finishGesture(event.clientX, "pointer");
      });
      carousel.addEventListener("pointercancel", () => {
        pointerStartX = undefined;
        pointerCurrentX = undefined;
        gestureType = undefined;
        startAutoplay();
      });
      carousel.addEventListener("touchstart", (event) => {
        if (event.touches.length === 1) beginGesture(event.touches[0].clientX, "touch");
      }, { passive: true });
      carousel.addEventListener("touchmove", (event) => {
        if (gestureType === "touch" && event.touches.length === 1) pointerCurrentX = event.touches[0].clientX;
      }, { passive: true });
      carousel.addEventListener("touchend", (event) => {
        const touch = event.changedTouches[0];
        if (touch) finishGesture(touch.clientX, "touch");
      }, { passive: true });
    carousel.addEventListener("mouseenter", stopAutoplay);
    carousel.addEventListener("mouseleave", startAutoplay);
    carousel.addEventListener("focusin", stopAutoplay);
    carousel.addEventListener("focusout", (event) => {
      if (!carousel.contains(event.relatedTarget)) startAutoplay();
    });
    carousel.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") showSlide(activeIndex - 1);
      if (event.key === "ArrowRight") showSlide(activeIndex + 1);
    });

      showSlide(0);
      startAutoplay();
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeCarousels, { once: true });
  } else {
    initializeCarousels();
  }
</script>

<style>
  .project-carousel {
    width: min(100%, 620px);
    margin: 0 auto;
    touch-action: pan-y;
  }

  .project-carousel__viewport {
    position: relative;
    overflow: hidden;
    min-height: 12rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(15, 23, 42, 0.18);
  }

  .project-carousel__track {
    display: grid;
    width: 100%;
  }

  .project-carousel__slide {
    position: absolute;
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    width: 100%;
    padding: 1rem;
    border: 0;
    background: transparent;
    cursor: zoom-in;
    opacity: 0;
    pointer-events: none;
    transform: translateX(1.5rem);
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .project-carousel__slide--active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  .project-carousel__slide img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: min(70vh, 500px);
    object-fit: contain;
    border-radius: 4px;
  }

  .project-carousel--fixed .project-carousel__viewport {
    aspect-ratio: var(--carousel-aspect-ratio);
    min-height: 0;
  }

  .project-carousel--fixed .project-carousel__track,
  .project-carousel--fixed .project-carousel__slide {
    height: 100%;
  }

  .project-carousel--fixed .project-carousel__slide--active {
    position: absolute;
  }

  .project-carousel__arrow {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.72);
    color: white;
    cursor: pointer;
    transform: translateY(-50%);
  }

  .project-carousel__arrow:hover,
  .project-carousel__arrow:focus-visible {
    background: rgba(37, 99, 235, 0.9);
  }

  .project-carousel__arrow--previous { left: 0.75rem; }
  .project-carousel__arrow--next { right: 0.75rem; }

  .project-carousel__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.75rem;
  }

  .project-carousel__dot {
    width: 0.65rem;
    height: 0.65rem;
    padding: 0;
    border: 1px solid var(--primary-text);
    border-radius: 999px;
    background: transparent;
    cursor: pointer;
  }

  .project-carousel__dot--active {
    background: var(--primary-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-carousel__slide { transition: none; }
  }
</style>
