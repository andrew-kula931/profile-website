---
import "../styles/global.css";
import Github from "../assets/github.astro";
import LinkedIn from "../assets/linkedIn.astro";
---

<nav class="flex flex-row justify-between items-center p-2 bg-gradient-to-t from-blue-300 to-blue-700 
dark:from-slate-900 dark:to-stone-950 dark:text-gray-300 border-b border-slate-700">
    <a href="/profile-website/" class="desktop text-2xl font-semibold hover:text-gray-700 dark:hover:text-gray-400">Andrew Kula</a>
    <a href="/profile-website/" class="mobile text-xl font-semibold hover:text-gray-700 dark:hover:text-gray-400">Andrew Kula</a>

    <div id="links" class="flex flex-row items-center space-x-3">
        <a href="/profile-website/writing/writing" class="hover:text-gray-700 dark:hover:text-gray-400">Writing</a>
        <a href="/profile-website/about" class="hover:text-gray-700 dark:hover:text-gray-400">About</a>
        <a href="/profile-website/projects"class="hover:text-gray-700 dark:hover:text-gray-400">Projects</a>
        <div class="desktop">
            <Github />
        </div>
        <div class="desktop">
            <LinkedIn />
        </div>
        <div>
            <div id="day_button" class="text-white bg-gray-800 w-[32px] rounded p-1 cursor-pointer hover:bg-gray-700">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <circle cx="12" cy="12" r="5" stroke-width="2"/>
                <path stroke-width="2" d="M12 1v2m0 18v2m11-11h-2M3 12H1m16.95-6.95l-1.414 1.414M6.464 17.536l-1.414 1.414m0-13.657l1.414 1.414M18.364 18.364l1.414 1.414"/>
                </svg>
            </div>
            <div id="night_button" class="bg-blue-500 w-[32px] rounded p-1 cursor-pointer hover:bg-blue-400 hidden">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                <path d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"/>
                </svg>
            </div>
        </div>
    </div>
</nav>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        const dayButton = document.getElementById('day_button');
        const nightButton = document.getElementById('night_button');

        // Toggle button click event listener
        dayButton?.addEventListener('click', () => {
            setTheme('light');
            dayButton.classList.add('hidden');
            nightButton?.classList.remove('hidden');
        });

        nightButton?.addEventListener('click', () => {
            setTheme('dark');
            nightButton.classList.add('hidden');
            dayButton?.classList.remove('hidden');
        });
    });

    // Function to set the theme
    const setTheme = (theme: string) => {
        if (theme === 'dark') {
            document.documentElement.classList.add('dark');
            localStorage.setItem('theme', 'dark');
        } else {
            document.documentElement.classList.remove('dark');
            localStorage.setItem('theme', 'light');
        }
    };
</script>

<style>
    .mobile {
        display: none;
    }
    .desktop {
        display: block;
    }

    @media (max-width: 500px) {
        .mobile {
        display: block;
        }
        .desktop {
        display: none;
        }
    }
</style>