---
import Github from "../assets/github.astro";
import LinkedIn from "../assets/linkedIn.astro";
---

<nav
    class="flex flex-row justify-between items-center px-3 sm:px-6 h-14 bg-gradient-to-t from-stone-200/95 to-stone-50/95
dark:from-slate-900/95 dark:to-stone-950/95 backdrop-blur-md text-stone-800 dark:text-gray-300 border-b border-stone-300/80 dark:border-slate-700"
>
    <a
        href="/profile-website/"
        class="desktop text-2xl font-semibold hover:text-blue-600 dark:hover:text-sky-400 transition-colors"
    >
        Andrew Kula
    </a>
    <a
        href="/profile-website/"
        class="mobile text-xl font-semibold hover:text-blue-600 dark:hover:text-sky-400 transition-colors"
    >
        Andrew Kula
    </a>

    <div id="links" class="flex flex-row items-center space-x-3">
        <a
            href="/profile-website/writing"
            class="text-sm font-medium hover:text-blue-600 dark:hover:text-sky-400 transition-colors"
        >
            Writing
        </a>
        <a
            href="/profile-website/about"
            class="text-sm font-medium hover:text-blue-600 dark:hover:text-sky-400 transition-colors"
        >
            About
        </a>
        <a
            href="/profile-website/projects"
            class="text-sm font-medium hover:text-blue-600 dark:hover:text-sky-400 transition-colors"
        >
            Projects
        </a>
        <div class="desktop">
            <Github />
        </div>
        <div class="desktop">
            <LinkedIn />
        </div>
        <div>
            <div
                id="day_button"
                class="flex items-center justify-center w-9 h-9 rounded-lg border border-stone-300/80 dark:border-slate-700/80 bg-stone-100/90 dark:bg-slate-800/90 text-stone-700 dark:text-slate-200 hover:border-stone-400 dark:hover:border-sky-400/50 transition-colors cursor-pointer"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <circle cx="12" cy="12" r="5" stroke-width="2" />
                    <path
                        stroke-width="2"
                        d="M12 1v2m0 18v2m11-11h-2M3 12H1m16.95-6.95l-1.414 1.414M6.464 17.536l-1.414 1.414m0-13.657l1.414 1.414M18.364 18.364l1.414 1.414"
                    />
                </svg>
            </div>
            <div
                id="night_button"
                class="flex items-center justify-center w-9 h-9 rounded-lg border border-stone-300/80 dark:border-slate-700/80 bg-stone-100/90 dark:bg-slate-800/90 text-stone-700 dark:text-slate-200 hover:border-stone-400 dark:hover:border-sky-400/50 transition-colors cursor-pointer hidden"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z" />
                </svg>
            </div>
        </div>
    </div>
</nav>

<script>
    window.addEventListener("DOMContentLoaded", () => {
        const dayButton = document.getElementById("day_button");
        const nightButton = document.getElementById("night_button");

        const isDark = document.documentElement.classList.contains("dark");
        dayButton?.classList.toggle("hidden", !isDark);
        nightButton?.classList.toggle("hidden", isDark);

        dayButton?.addEventListener("click", () => {
            setTheme("light");
            dayButton.classList.add("hidden");
            nightButton?.classList.remove("hidden");
        });

        nightButton?.addEventListener("click", () => {
            setTheme("dark");
            nightButton.classList.add("hidden");
            dayButton?.classList.remove("hidden");
        });
    });

    const setTheme = (theme: string) => {
        if (theme === "dark") {
            document.documentElement.classList.add("dark");
            localStorage.setItem("theme", "dark");
        } else {
            document.documentElement.classList.remove("dark");
            localStorage.setItem("theme", "light");
        }
    };
</script>

<style>
    .mobile {
        display: none;
    }
    .desktop {
        display: block;
    }

    @media (max-width: 500px) {
        .mobile {
            display: block;
        }
        .desktop {
            display: none;
        }
    }
</style>
