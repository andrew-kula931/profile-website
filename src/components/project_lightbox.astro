<div
  id="project-lightbox"
  role="dialog"
  aria-modal="true"
  aria-label="Expanded project screenshot"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm sm:p-8"
>
  <div
    data-lightbox-panel
    class="relative flex max-h-[92vh] max-w-6xl flex-col overflow-hidden rounded-2xl border border-stone-400/30 bg-stone-900/95 shadow-2xl dark:border-slate-700"
  >
    <div class="flex items-center justify-between gap-4 border-b border-slate-800 px-4 py-3 text-slate-200">
      <p id="lightbox-caption" class="truncate font-mono text-xs text-slate-300">
        Screenshot preview
      </p>
      <button
        type="button"
        id="lightbox-close"
        aria-label="Close fullscreen preview"
        class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-slate-700 bg-slate-800 text-slate-300 transition-colors hover:border-sky-400/50 hover:text-white"
      >
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="flex items-center justify-center overflow-auto p-3 sm:p-5">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="max-h-[78vh] w-auto max-w-full rounded-lg object-contain"
      />
    </div>
  </div>
</div>

<script>
  const setupLightbox = () => {
    const lightbox = document.getElementById("project-lightbox");
    const lightboxImg = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const lightboxCaption = document.getElementById("lightbox-caption");
    const closeBtn = document.getElementById("lightbox-close");
    if (!lightbox || !lightboxImg) return;

    const openLightbox = (img: HTMLImageElement) => {
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      if (lightboxCaption) {
        lightboxCaption.textContent = img.alt || "Screenshot preview";
      }
      lightbox.classList.remove("hidden");
      lightbox.classList.add("flex");
      document.body.style.overflow = "hidden";
    };

    const closeLightbox = () => {
      lightbox.classList.add("hidden");
      lightbox.classList.remove("flex");
      document.body.style.overflow = "";
    };

    document
      .querySelectorAll<HTMLElement>("[data-carousel-slide]")
      .forEach((slideBtn) => {
        slideBtn.addEventListener("click", () => {
          const img = slideBtn.querySelector("img");
          if (img) openLightbox(img);
        });
      });

    closeBtn?.addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !lightbox.classList.contains("hidden")) {
        closeLightbox();
      }
    });
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupLightbox, { once: true });
  } else {
    setupLightbox();
  }
</script>
