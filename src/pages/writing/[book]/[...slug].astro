---
import Layout from "../../../layout/layout.astro";
import Nav from "../../../components/novel_nav.astro";
import PageNav from "../../../components/novel_page_nav.astro";
import { type CollectionEntry, getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const chapters = await getCollection("chapters");
  return chapters.map((chapter) => {
    const [book, ...slug] = chapter.id.split("/");
    return { params: { book, slug: slug.join("/") }, props: chapter };
  });
}
type Props = CollectionEntry<"chapters">;
const allChapters = await getCollection("chapters");

const book = Astro.props;
const { Content } = await render(book);
const bookId = book.id.split("/")[0];
const bookChapters = allChapters
  .filter((chapter) => chapter.id.split("/")[0] === bookId)
  .sort((a, b) => a.data.chapNum - b.data.chapNum);
const bookUrl = `${import.meta.env.BASE_URL}writing/${bookId}`;
const chapterIndex = bookChapters.findIndex(
  (chapter) => chapter.id === book.id,
);

const prevBook = bookChapters[chapterIndex - 1];
const prevHref = prevBook
  ? `${import.meta.env.BASE_URL}writing/${prevBook.id}`
  : undefined;
const nextBook = bookChapters[chapterIndex + 1];
const nextHref = nextBook
  ? `${import.meta.env.BASE_URL}writing/${nextBook.id}`
  : undefined;
---

<Layout title={book.data.title}>
  <div
    class="fixed inset-0 -z-10 bg-gradient-to-b from-stone-100 to-stone-200 dark:from-slate-900 dark:via-slate-800 dark:to-slate-950"
  >
  </div>
  <div class="flex flex-col min-h-screen">
    <Nav
      title={book.data.book}
      chapter={book.data.title}
      prevFilePath={`${bookUrl}/toc`}
    />
    <div
      id="day_button"
      class="text-white bg-gray-800 w-[32px] rounded p-1 cursor-pointer absolute right-2 top-3 hover:bg-gray-700"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <circle cx="12" cy="12" r="5" stroke-width="2"></circle>
        <path
          stroke-width="2"
          d="M12 1v2m0 18v2m11-11h-2M3 12H1m16.95-6.95l-1.414 1.414M6.464 17.536l-1.414 1.414m0-13.657l1.414 1.414M18.364 18.364l1.414 1.414"
        ></path>
      </svg>
    </div>
    <div
      id="night_button"
      class="bg-stone-600 w-[32px] rounded p-1 cursor-pointer absolute right-2 top-3 hover:bg-stone-500 hidden"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="w-6 h-6"
        fill="currentColor"
        viewBox="0 0 24 24"
      >
        <path d="M21 12.79A9 9 0 1111.21 3a7 7 0 109.79 9.79z"></path>
      </svg>
    </div>
    <!-- Chapter Content -->

    <main class="flex justify-center px-4 py-6">
      <article
        class="markdown-body home-tile-hoverless w-full max-w-[800px] p-8 pt-2"
      >
        <h2>{book.data.title}</h2>
        {
          book.data.updatedDate ? (
            <div>
              <div>
                Written: {book.data.pubDate.toLocaleDateString()} | Updated:{" "}
                {book.data.updatedDate.toLocaleDateString()}
              </div>
            </div>
          ) : (
            <div>Written: {book.data.pubDate.toLocaleDateString()}</div>
          )
        }
        <div>
          {
            book.data.updatedDate ? (
              <div>Updated: {book.data.updatedDate ?? ""}</div>
            ) : (
              <div />
            )
          }
        </div>
        <br />

        <Content />
        <PageNav
          prevHref={prevHref}
          prevTitle={prevBook?.data.title}
          nextHref={nextHref}
          nextTitle={nextBook?.data.title}
        />
      </article>
    </main>
  </div>
  <script>
    window.addEventListener("DOMContentLoaded", () => {
      const isDark = document.documentElement.classList.contains("dark");
      document
        .getElementById("day_button")
        ?.classList.toggle("hidden", !isDark);
      document
        .getElementById("night_button")
        ?.classList.toggle("hidden", isDark);
      document
        .getElementById("night_button")
        ?.addEventListener("click", () => switchTheme(true));
      document
        .getElementById("day_button")
        ?.addEventListener("click", () => switchTheme(false));
    });

    function switchTheme(isDay: boolean) {
      const html = document.documentElement;
      const night = document.getElementById("night_button");
      const day = document.getElementById("day_button");

      if (isDay) {
        html.classList.add("dark");
        localStorage.setItem("theme", "dark");
        night?.classList.add("hidden");
        day?.classList.remove("hidden");
      } else {
        html.classList.remove("dark");
        localStorage.setItem("theme", "light");
        night?.classList.remove("hidden");
        day?.classList.add("hidden");
      }
    }
  </script>
</Layout>
