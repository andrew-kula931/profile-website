---
import Layout from "../layout/layout.astro";
import Nav from "../components/nav.astro";
import { getCollection } from "astro:content";

declare global {
  interface ImportMetaEnv {
    BASE_URL: string;
  }

  interface ImportMeta {
    readonly env: ImportMetaEnv;
  }
}

interface BookMetadata {
  description?: string | string[];
  cover?: string;
  coverImage?: string;
  image?: string;
}

function parseInline(str: string): string {
  let res = str
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");

  // Inline code: `code`
  res = res.replace(
    /`([^`]+)`/g,
    '<code class="px-1.5 py-0.5 rounded bg-stone-200/80 dark:bg-slate-700/80 text-xs font-mono">$1</code>',
  );

  // Bold & Italic: ***text*** or ___text___
  res = res.replace(/(\*\*\*|___)(.*?)\1/g, "<strong><em>$2</em></strong>");

  // Bold: **text** or __text__
  res = res.replace(/(\*\*|__)(.*?)\1/g, "<strong>$2</strong>");

  // Italic: *text* or _text_ (supports punctuation & boundaries)
  res = res.replace(/(^|[^\w])(\*|_)(.*?)\2(?=[^\w]|$)/g, "$1<em>$3</em>");

  // Strikethrough: ~~text~~
  res = res.replace(/~~(.*?)~~/g, '<del class="opacity-75">$1</del>');

  // Links: [text](url) -> rendered as styled link to avoid invalid nested <a> within tile link
  res = res.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<span class="underline underline-offset-2 font-medium text-blue-600 dark:text-sky-400" title="$2">$1</span>',
  );

  return res;
}

function renderMarkdown(input?: string | string[]): string {
  if (!input) return "";
  const rawText = Array.isArray(input) ? input.join("\n\n") : input;
  const text = rawText.trim();
  if (!text) return "";

  const blocks = text.split(/\n\s*\n/);
  const htmlBlocks: string[] = [];

  for (const rawBlock of blocks) {
    const block = rawBlock.trim();
    if (!block) continue;

    // Horizontal rule
    if (/^(-{3,}|\*{3,}|_{3,})$/.test(block)) {
      htmlBlocks.push(
        '<hr class="my-3 border-stone-300 dark:border-slate-700" />',
      );
      continue;
    }

    // Headings
    const headingMatch = block.match(/^(#{1,6})\s+(.*)$/);
    if (headingMatch) {
      const level = headingMatch[1].length;
      const content = parseInline(headingMatch[2]);
      const headingClass =
        level === 1
          ? "text-lg font-bold my-1 text-stone-900 dark:text-stone-100"
          : level === 2
            ? "text-base font-bold my-1 text-stone-900 dark:text-stone-100"
            : "text-sm font-bold my-0.5 text-stone-900 dark:text-stone-100";
      htmlBlocks.push(
        `<h${level} class="${headingClass}">${content}</h${level}>`,
      );
      continue;
    }

    // Blockquote
    if (block.startsWith(">")) {
      const quoteLines = block
        .split("\n")
        .map((line) => line.replace(/^>\s?/, ""));
      const content = parseInline(quoteLines.join(" "));
      htmlBlocks.push(
        `<blockquote class="border-l-2 border-stone-400 dark:border-slate-500 pl-3 my-1.5 italic text-stone-600 dark:text-stone-300 opacity-90">${content}</blockquote>`,
      );
      continue;
    }

    // Unordered list
    if (block.split("\n").every((line) => /^[-*+]\s+/.test(line.trim()))) {
      const items = block.split("\n").map((line) => {
        const itemText = line.trim().replace(/^[-*+]\s+/, "");
        return `<li class="my-0.5">${parseInline(itemText)}</li>`;
      });
      htmlBlocks.push(
        `<ul class="list-disc pl-5 my-1.5 space-y-1">${items.join("")}</ul>`,
      );
      continue;
    }

    // Ordered list
    if (block.split("\n").every((line) => /^\d+\.\s+/.test(line.trim()))) {
      const items = block.split("\n").map((line) => {
        const itemText = line.trim().replace(/^\d+\.\s+/, "");
        return `<li class="my-0.5">${parseInline(itemText)}</li>`;
      });
      htmlBlocks.push(
        `<ol class="list-decimal pl-5 my-1.5 space-y-1">${items.join("")}</ol>`,
      );
      continue;
    }

    // Paragraph
    const lines = block.split("\n").map((line) => {
      return line.endsWith("  ")
        ? parseInline(line.slice(0, -2)) + "<br />"
        : parseInline(line);
    });
    htmlBlocks.push(`<p class="leading-relaxed">${lines.join(" ")}</p>`);
  }

  return htmlBlocks.join("");
}

const chapters = await getCollection("chapters");
const metadata = import.meta.glob<BookMetadata>("../content/*/book.json", {
  eager: true,
  import: "default",
});
const descriptionMarkdown = import.meta.glob<string>(
  "../content/*/{description,summary,synopsis}.md",
  { eager: true, query: "?raw", import: "default" },
);
const coverImages = import.meta.glob<{ default: string | { src: string } }>(
  "../content/*/*.{png,jpg,jpeg,webp,avif}",
  { eager: true },
);

const books = new Map<
  string,
  {
    title: string;
    descriptionHtml?: string;
    cover?: string;
  }
>();

for (const chapter of chapters) {
  const bookId = chapter.id.split("/")[0];
  const bookDirectory =
    chapter.filePath?.replace(/^src\/content\//, "").split("/")[0] ?? bookId;
  const bookMeta = metadata[`../content/${bookDirectory}/book.json`];

  const matchedCoverImage =
    coverImages[`../content/${bookDirectory}/cover.png`] ??
    coverImages[`../content/${bookDirectory}/cover.jpg`] ??
    coverImages[`../content/${bookDirectory}/cover.jpeg`] ??
    coverImages[`../content/${bookDirectory}/cover.webp`] ??
    coverImages[`../content/${bookDirectory}/cover.avif`];

  const detectedCover =
    typeof matchedCoverImage?.default === "string"
      ? matchedCoverImage.default
      : matchedCoverImage?.default?.src;

  const rawCover =
    bookMeta?.cover ?? bookMeta?.coverImage ?? bookMeta?.image ?? detectedCover;

  const resolvedCover = rawCover
    ? rawCover.startsWith("http://") ||
      rawCover.startsWith("https://") ||
      rawCover.startsWith(import.meta.env.BASE_URL)
      ? rawCover
      : rawCover.startsWith("/")
        ? `${import.meta.env.BASE_URL.replace(/\/$/, "")}${rawCover}`
        : `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${rawCover}`
    : undefined;

  const rawDescription =
    bookMeta?.description ??
    descriptionMarkdown[`../content/${bookDirectory}/description.md`] ??
    descriptionMarkdown[`../content/${bookDirectory}/summary.md`] ??
    descriptionMarkdown[`../content/${bookDirectory}/synopsis.md`];

  const descriptionHtml = renderMarkdown(rawDescription);

  books.set(bookId, {
    title: chapter.data.book,
    descriptionHtml,
    cover: resolvedCover,
  });
}
---

<Layout title="Novel Directory">
  <div class="flex flex-col min-h-screen bg-gradient-to-b from-stone-100 to-stone-200 dark:from-slate-900 dark:via-gray-800 dark:to-black">
    <Nav />
    <section class="flex justify-center px-4 py-6">
      <div class="flex flex-col space-y-4 w-full max-w-[850px] self-center">
        {[...books.entries()]
          .sort((a, b) => a[1].title.localeCompare(b[1].title))
          .map(([bookId, book]) => (
            <a
              href={`${import.meta.env.BASE_URL}writing/${bookId}/toc`}
              class="group block no-underline focus:outline-none focus-visible:ring-2 focus-visible:ring-stone-400 dark:focus-visible:ring-slate-500 rounded-lg"
            >
              <div class="home-tile rounded-lg p-5 sm:p-6 bg-gradient-to-r from-stone-50 to-stone-200 dark:from-slate-800 dark:to-slate-900 dark:text-white">
                <div class="flex flex-col sm:flex-row gap-5 sm:gap-6 items-start">
                  <!-- Book Cover Space -->
                  <div class="self-center sm:self-start shrink-0">
                    <div class="relative w-28 sm:w-36 md:w-40 aspect-[2/3] rounded-md overflow-hidden shadow-md border border-stone-300/80 dark:border-slate-700/80 bg-gradient-to-br from-stone-200 via-stone-300 to-stone-400 dark:from-slate-700 dark:via-slate-800 dark:to-slate-900 flex items-center justify-center">
                      {book.cover ? (
                        <img
                          src={book.cover}
                          alt={`Cover of ${book.title}`}
                          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                          loading="lazy"
                        />
                      ) : (
                        <div class="flex flex-col items-center justify-center p-3 text-center text-stone-500 dark:text-slate-400 select-none">
                          <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="w-9 h-9 sm:w-10 sm:h-10 opacity-60 mb-1.5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="1.5"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"
                            />
                          </svg>
                          <span class="text-[11px] font-semibold uppercase tracking-wider opacity-75">
                            Book Cover
                          </span>
                        </div>
                      )}
                      <!-- Book spine accent -->
                      <div class="absolute left-0 top-0 bottom-0 w-1.5 sm:w-2 bg-black/10 dark:bg-white/10 border-r border-black/10 dark:border-white/10 pointer-events-none" />
                    </div>
                  </div>

                  <!-- Book Content / Details -->
                  <div class="flex flex-col flex-1 min-w-0 w-full">
                    <div class="flex items-center justify-between gap-3 mb-2">
                      <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-100 group-hover:text-blue-600 dark:group-hover:text-sky-400 transition-colors">
                        {book.title}
                      </h2>
                      <span class="inline-flex items-center gap-1 text-xs sm:text-sm font-medium text-stone-500 dark:text-slate-400 group-hover:text-blue-600 dark:group-hover:text-sky-400 transition-colors shrink-0">
                        <span>Read</span>
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 5l7 7-7 7"
                          />
                        </svg>
                      </span>
                    </div>

                    {book.descriptionHtml && (
                      <div class="mt-1">
                        <p class="text-xs font-semibold uppercase tracking-wider text-stone-500 dark:text-slate-400 mb-2">
                          Summary
                        </p>
                        <div
                          class="markdown-description space-y-2.5 text-stone-700 dark:text-stone-300 text-sm sm:text-[15px] leading-relaxed"
                          set:html={book.descriptionHtml}
                        />
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </a>
          ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .markdown-description :global(strong) {
    font-weight: 700;
    color: inherit;
  }
  .markdown-description :global(em) {
    font-style: italic;
  }
  .markdown-description :global(del) {
    text-decoration: line-through;
    opacity: 0.75;
  }
  .markdown-description :global(blockquote) {
    border-left: 3px solid rgba(120, 113, 108, 0.45);
    padding-left: 0.75rem;
    margin: 0.5rem 0;
    font-style: italic;
    opacity: 0.9;
  }
  :global(.dark) .markdown-description :global(blockquote) {
    border-left-color: rgba(148, 163, 184, 0.45);
  }
  .markdown-description :global(ul) {
    list-style-type: disc;
    padding-left: 1.25rem;
    margin: 0.5rem 0;
  }
  .markdown-description :global(ol) {
    list-style-type: decimal;
    padding-left: 1.25rem;
    margin: 0.5rem 0;
  }
  .markdown-description :global(li) {
    margin: 0.15rem 0;
  }
  .markdown-description :global(code) {
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    font-size: 0.85em;
    font-family: monospace;
    background: rgba(120, 113, 108, 0.15);
  }
  :global(.dark) .markdown-description :global(code) {
    background: rgba(30, 41, 59, 0.8);
    color: rgb(226, 232, 240);
  }
</style>
