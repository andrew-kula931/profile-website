---
import Nav from '../components/nav.astro';
import Footer from '../components/footer.astro';
import '../styles/global.css';
---
<html id="html" lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Andrew Kula</title>
  </head>
  <body>

    <div class="overlay" id="overlay" onclick="closeFullscreen()">
      <img class="fullscreen-img" id="fullscreen-img" src="/profile-website/PurchaseOrder.png" alt="Purchase Order Tracking Application">
    </div>  

    <div class="flex flex-col h-full bg-gradient-to-b from-blue-200 to-blue-400 dark:from-slate-900 dark:via-slate-800 dark:to-black">
      <Nav />
      <div class="flex items-center justify-center">
        <div class="flex flex-col p-2 space-y-2 justify-center items-center">
          <div 
            id="whoami" 
            class="home-tile w-full max-w-[970px] bg-gradient-to-r from-blue-300 to-blue-400 dark:from-slate-800 dark:to-slate-900 dark:text-white opacity-0
            translate-y-10 transition-all duration-700" >
            <p class="p-2 text-xl">Who Am I?</p>
            <p class="pl-4 pr-4 pb-4">Currently a software engineering student at the University of Nebraska-Lincoln while also working in industry and participating in research.</p>
            <a href="/profile-website/andrewkula20260826.pdf" target="_blank" rel="noopener noreferrer" 
              class="pl-4 pb-4 inline-flex items-center gap-1 text-blue-600 font-medium underline underline-offset-4 decoration-2 hover:text-indigo-600"
            >
              Resume
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>

          </div>

          <div 
            id="2mation" 
            class="home-tile w-full max-w-[970px] bg-gradient-to-r from-blue-400 to-blue-300 dark:from-slate-900 dark:to-slate-800 dark:text-white opacity-0 
            translate-y-10 transition-all delay-200 duration-700"
          >
            <section class="flex flex-row justify-between items-center border-b-2 border-slate-600">
              <div class="flex flex-col">
                <p class="pl-2 pt-2 text-xl">2Mation Solutions Inc.</p>
                <p class="pl-2 text-xs">April 2024 - Present</p>
              </div>
              <img class="h-[75px] w-[100px] p-2" src="/profile-website/2mation.png" alt="2Mation Logo">
            </section>
            <p class="pl-4 pt-2 font-bold">Responsibilities:</p>
            <ul class="list-disc pl-8 pb-4 pt-1 space-y-1">
              <li>Developed and maintained multi-platform applications using a Flutter, PostgreSQL, and Azure stack.</li>
              <li>Designed and implemented database schemas, server-side logic, RLS, and microservices.</li>
              <li>Handled performance oriented processes and optimized client-server connections for smooth UX.</li>
              <li>Implemented realtime features such as chats using websockets.</li>
            </ul>

          </div>
          <div 
            id="consystlab" 
            class="home-tile w-full max-w-[970px] bg-gradient-to-r from-blue-400 to-blue-300 dark:from-slate-900 dark:to-slate-800 dark:text-white opacity-0 
            translate-y-10 transition-all delay-200 duration-700"
          >
            <section class="flex flex-row justify-between items-center border-b-2 border-slate-600">
              <div class="flex flex-col">
                <p class="pl-2 pt-2 text-xl">Consystlab - University of Nebraska-Lincoln</p>
                <p class="pl-2 text-xs pb-2">October 2025 - Present</p>
              </div>
            </section>
            <p class="pl-4 pt-2 font-bold">Responsbilities:</p>
            <ul class="list-disc pl-8 pb-4 pt-1 space-y-1">
              <li>Developed data visualization software to summarize large sets of data.</li>
              <li>Analyzed CSP algorithms and heuristics to better understand problem instances.</li>
              <li>Collaborated with a team of researchers to design and implement software.</li>
            </ul>

          </div>
        </div>
      </div>
      <Footer/>
    </div>
  </body>
  <script>
    window.addEventListener('DOMContentLoaded', () => {
      const content = document.getElementById('whoami');
      content?.classList.remove('opacity-0', 'translate-y-10');
      content?.classList.add('opacity-100', 'translate-y-0');

      const content2 = document.getElementById('2mation');
      content2?.classList.remove('opacity-0', 'translate-y-10');
      content2?.classList.add('opacity-100', 'translate-y-0');

      const content3 = document.getElementById('consystlab');
      content3?.classList.remove('opacity-0', 'translate-y-10');
      content3?.classList.add('opacity-100', 'translate-y-0');

      const poImage = document.getElementById('poImage') as HTMLImageElement;
      const liftUpImage = document.getElementById('LiftUpImage') as HTMLImageElement;
      const overlay = document.getElementById('overlay');
      poImage.addEventListener("click", () => openFullscreen(poImage));
      liftUpImage.addEventListener("click", () => openFullscreen(liftUpImage));
      overlay?.addEventListener("click", closeFullscreen);
    })

    function openFullscreen(img: HTMLImageElement) {
      const overlay = document.getElementById("overlay");
      const overlayImage = document.getElementById("fullscreen-img") as HTMLImageElement;

      overlayImage!.src = img.src;
      overlay!.style.display = 'flex';
    }

    function closeFullscreen() {
      document.getElementById("overlay")!.style.display = 'none';
    }
  </script>
</html>